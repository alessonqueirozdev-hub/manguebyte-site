        ]
      ],
      "lines": [
        {
          "text": "#[test]"
        },
        {
          "text": "fn the_song_is_the_same_whatever_the_block_size() {"
        },
        {
          "text": "    let reference = render(256, &[256]);"
        },
        {
          "text": "    assert!(reference.peak() > 0.1, \"the reference render is silent\");"
        },
        {
          "text": ""
        },
        {
          "text": "    for (max_block_size, pattern) in ["
        },
        {
          "text": "        (64, &[64][..]),"
        },
        {
          "text": "        (1024, &[1024]),"
        },
        {
          "text": "        // Odd lengths that never line up with a note boundary."
        },
        {
          "text": "        (997, &[997]),"
        },
        {
          "text": "        // A host that changes its mind on every call."
        },
        {
          "text": "        (512, &[1, 511, 7, 300, 64, 2, 129]),"
        },
        {
          "text": "        // Blocks larger than the player's own, which it must split itself."
        },
        {
          "text": "        (48, &[5_000]),"
        },
        {
          "text": "    ] {"
        },
        {
          "text": "        let other = render(max_block_size, pattern);"
        },
        {
          "text": "        assert!("
        },
        {
          "text": "            other == reference,"
        },
        {
          "text": "            \"blocks of {pattern:?} (max {max_block_size}) changed the output\""
        },
        {
          "text": "        );"
        },
        {
          "text": "    }"
        },
        {
          "text": "}"
        }
      ]
    },
