        {
          "text": "#[test]"
        },
        {
          "text": "fn automation_lands_on_its_frame_with_audio_running_through() {"
        },
        {
          "text": "    let mut harness = Harness::<Duck>::new(RATE, 256);"
        },
        {
          "text": "    let input = steady(1.0, 24_000);"
        },
        {
          "text": "    let loud = steady(1.0, 24_000);"
        },
        {
          "text": "    // Let the follower settle, then ask for a different depth on one"
        },
        {
          "text": "    // particular frame in the middle of a block."
        },
        {
          "text": "    harness.process_with_sidechain(&input, &loud);"
        },
        {
          "text": "    harness.automate(24_000 + 1_000, \"depth\", 24.0);"
        },
        {
          "text": "    let output = harness.process_with_sidechain(&input, &loud);"
        },
        {
          "text": ""
        },
        {
          "text": "    let before = db_to_gain(-12.0) as f32;"
        },
        {
          "text": "    let after = db_to_gain(-24.0) as f32;"
        },
        {
          "text": "    assert!((output.channel(0)[999] - before).abs() < 1e-4);"
        },
        {
          "text": "    assert!((output.channel(0)[1_000] - after).abs() < 1e-4);"
        },
        {
          "text": "}"
        }
      ]
    },
