        {
          "text": "#[test]"
        },
        {
          "text": "fn plays_the_pitch_it_is_asked_for() {"
        },
        {
          "text": "    use manguebyte::dsp::fft::{Complex, RealFft};"
        },
        {
          "text": ""
        },
        {
          "text": "    let mut harness = Harness::<Pluck>::new(RATE, 512);"
        },
        {
          "text": "    harness.params().reverb.set(0.0);"
        },
        {
          "text": "    // No resonant peak, so the fundamental is the loudest partial."
        },
        {
          "text": "    harness.params().resonance.set(0.7);"
        },
        {
          "text": "    harness.note(0, 40_000, 69, 1.0); // A4, 440 Hz"
        },
        {
          "text": "    let sound = harness.render(32_768);"
        },
        {
          "text": ""
        },
        {
          "text": "    let mut fft = RealFft::<f32>::new(32_768);"
        },
        {
          "text": "    let mut spectrum = vec![Complex::ZERO; fft.spectrum_len()];"
        },
        {
          "text": "    fft.forward(sound.channel(0), &mut spectrum);"
        },
        {
          "text": "    let loudest = (1..spectrum.len())"
        },
        {
          "text": "        .max_by(|&a, &b| spectrum[a].norm_sqr().total_cmp(&spectrum[b].norm_sqr()))"
        },
        {
          "text": "        .unwrap();"
        },
        {
          "text": "    let hertz = loudest as f64 * RATE / 32_768.0;"
        },
        {
          "text": "    assert!((hertz - 440.0).abs() < 2.0, \"loudest partial at {hertz} Hz\");"
        },
        {
          "text": "}"
        }
      ]
    },
