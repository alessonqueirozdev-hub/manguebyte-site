    "duck-test": {
      "repo": null,
      "file": "plugins/duck/src/lib.rs",
      "lang": "rust",
      "ranges": [
        [
          483,
          498
        ]
      ],
      "lines": [
        {
          "text": "#[test]"
        },
        {
          "text": "fn automation_lands_on_its_frame_with_audio_running_through() {"
        },
        {
          "text": "    let mut harness = Harness::<Duck>::new(RATE, 256);"
        },
        {
          "text": "    let input = steady(1.0, 24_000);"
        },
        {
          "text": "    let loud = steady(1.0, 24_000);"
        },
        {
          "text": "    // Let the follower settle, then ask for a different depth on one"
        },
        {
          "text": "    // particular frame in the middle of a block."
        },
        {
          "text": "    harness.process_with_sidechain(&input, &loud);"
        },
        {
          "text": "    harness.automate(24_000 + 1_000, \"depth\", 24.0);"
        },
        {
          "text": "    let output = harness.process_with_sidechain(&input, &loud);"
        },
        {
          "text": ""
        },
        {
          "text": "    let before = db_to_gain(-12.0) as f32;"
        },
        {
          "text": "    let after = db_to_gain(-24.0) as f32;"
        },
        {
          "text": "    assert!((output.channel(0)[999] - before).abs() < 1e-4);"
        },
        {
          "text": "    assert!((output.channel(0)[1_000] - after).abs() < 1e-4);"
        },
        {
          "text": "}"
        }
      ]
    },
    "test-automation": {
      "repo": null,
      "file": "crates/manguebyte-plugin/src/harness.rs",
      "lang": "rust",
      "ranges": [
        [
          411,
          429
        ]
      ],
      "lines": [
        {
          "text": "#[test]"
        },
        {
          "text": "fn automation_lands_on_its_exact_frame_and_updates_the_parameter() {"
        },
        {
          "text": "    let mut harness = Harness::<Level>::new(48_000.0, 64);"
        },
        {
          "text": "    harness.automate(100, \"level\", 2.0);"
        },
        {
          "text": "    harness.automate(101, \"level\", 3.0);"
        },
        {
          "text": "    harness.automate(250, \"level\", 0.5);"
        },
        {
          "text": ""
        },
        {
          "text": "    let output = harness.process(&ones(2, 300));"
        },
        {
          "text": "    let left = output.channel(0);"
        },
        {
          "text": "    assert_eq!(&left[..100], &[1.0; 100]);"
        },
        {
          "text": "    assert_eq!(left[100], 2.0);"
        },
        {
          "text": "    assert_eq!(&left[101..250], &[3.0; 149]);"
        },
        {
          "text": "    assert_eq!(&left[250..], &[0.5; 50]);"
        },
        {
          "text": "    assert_eq!(output.channel(1), left);"
        },
        {
          "text": ""
        },
        {
          "text": "    // Anything polling the parameter sees where automation left it."
        },
        {
          "text": "    assert_eq!(harness.params().level.value(), 0.5);"
        },
        {
          "text": "    assert_eq!(harness.position(), 300);"
        },
        {
          "text": "}"
        }
      ]
    },
    "test-block-size": {
      "repo": null,
