        {
          "text": "/// Runs `work` and panics if it used the heap in any way."
        },
        {
          "text": "fn assert_no_heap_use(what: &str, work: impl FnOnce()) {"
        },
        {
          "text": "    HEAP_CALLS.with(|calls| calls.set(0));"
        },
        {
          "text": "    WATCHING.with(|watching| watching.set(true));"
        },
        {
          "text": "    work();"
        },
        {
          "text": "    WATCHING.with(|watching| watching.set(false));"
        },
        {
          "text": "    let calls = HEAP_CALLS.with(Cell::get);"
        },
        {
          "text": "    assert_eq!("
        },
        {
          "text": "        calls, 0,"
        },
        {
          "text": "        \"{what} used the heap {calls} time(s) while processing\""
        },
        {
          "text": "    );"
        },
        {
          "text": "}"
        },
        {
          "gap": ""
        },
        {
          "text": "/// Prepares a processor, then runs it over blocks of several sizes with the"
        },
        {
          "text": "/// allocator watched."
        },
        {
          "text": "fn check<P: Processor<f32>>(what: &str, mut processor: P) {"
        },
        {
          "text": "    processor.prepare(&SPEC);"
        },
        {
          "text": "    let mut buffer = AudioBuffer::<f32>::new(SPEC.num_channels, SPEC.max_block_size);"
        },
        {
          "text": "    assert_no_heap_use(what, || {"
        },
        {
          "text": "        for frames in [256, 1, 64, 255, 256] {"
        },
        {
          "text": "            buffer.set_num_frames(frames);"
        },
        {
          "text": "            for channel in buffer.iter_channels_mut() {"
        },
        {
          "text": "                channel.fill(0.25);"
        },
        {
          "text": "            }"
        },
        {
          "text": "            processor.process(&mut buffer);"
        },
        {
          "text": "        }"
        },
        {
          "text": "        processor.reset();"
        },
        {
          "text": "        buffer.set_num_frames(256);"
        },
        {
          "text": "        processor.process(&mut buffer);"
        },
        {
          "text": "    });"
        },
        {
          "text": "}"
        }
      ]
    },
