          "text": "impl Plugin for Duck {"
        },
        {
          "text": "    const INFO: PluginInfo = PluginInfo {"
        },
        {
          "text": "        id: \"org.manguebyte.duck\","
        },
        {
          "text": "        name: \"Mangue Duck\","
        },
        {
          "text": "        vendor: \"Manguebyte\","
        },
        {
          "text": "        version: env!(\"CARGO_PKG_VERSION\"),"
        },
        {
          "text": "        description: \"A sidechain ducker, as an example of the Manguebyte framework\","
        },
        {
          "text": "        kind: PluginKind::Effect,"
        },
        {
          "text": "    };"
        },
        {
          "text": "    const LAYOUT: AudioLayout = AudioLayout {"
        },
        {
          "text": "        inputs: 2,"
        },
        {
          "text": "        outputs: 2,"
        },
        {
          "text": "        sidechain: 2,"
        },
        {
          "text": "    };"
        },
        {
          "text": "    type Params = DuckParams;"
        },
        {
          "gap": "    // ... new, params and prepare are left out here"
        },
        {
          "text": "    fn process(&mut self, buffer: &mut AudioBuffer<f32>, context: &ProcessContext<'_, f32>) {"
        },
        {
          "text": "        self.cursor = 0;"
        },
        {
          "text": "        let sidechain = context.sidechain;"
        },
        {
          "text": "        split_at_events(self, buffer, context.events, Self::handle, |duck, piece| {"
        },
        {
          "text": "            duck.render(piece, sidechain)"
